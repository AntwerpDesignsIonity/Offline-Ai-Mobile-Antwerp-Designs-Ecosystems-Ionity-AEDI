{
  "name": "offline-ai-copilot",
  "version": "1.0.0",
  "description": "Offline AI LLM CLI with GitHub Copilot features - works on any system including Android 7+",
  "main": "dist/index.js",
  "bin": {
    "ai-copilot": "./dist/cli.js",
    "offline-ai": "./dist/cli.js"
  },
  "scripts": {
